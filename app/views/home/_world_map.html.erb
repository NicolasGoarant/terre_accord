<div class="world-map-container relative bg-blue-50 rounded-lg p-6">
  <h3 class="text-xl font-bold text-center mb-4">Carte mondiale des engagements climatiques</h3>
  
  <!-- Carte du monde -->
  <div id="world-map" style="height: 500px; width: 100%; border-radius: 8px; overflow: hidden;"></div>
  
  <!-- Légende des scores -->
  <div class="legend flex flex-wrap justify-center gap-4 mt-6 p-4 bg-white rounded-lg shadow-sm">
    <div class="legend-item flex items-center gap-2">
      <div class="w-4 h-4 rounded-full" style="background-color: #15803d;"></div>
      <span class="text-sm">A - Exemplaire</span>
    </div>
    <div class="legend-item flex items-center gap-2">
      <div class="w-4 h-4 rounded-full" style="background-color: #16a34a;"></div>
      <span class="text-sm">B - Très bon</span>
    </div>
    <div class="legend-item flex items-center gap-2">
      <div class="w-4 h-4 rounded-full" style="background-color: #65a30d;"></div>
      <span class="text-sm">C - Bon</span>
    </div>
    <div class="legend-item flex items-center gap-2">
      <div class="w-4 h-4 rounded-full" style="background-color: #ca8a04;"></div>
      <span class="text-sm">D - Moyen</span>
    </div>
    <div class="legend-item flex items-center gap-2">
      <div class="w-4 h-4 rounded-full" style="background-color: #ea580c;"></div>
      <span class="text-sm">E - Insuffisant</span>
    </div>
    <div class="legend-item flex items-center gap-2">
      <div class="w-4 h-4 rounded-full" style="background-color: #dc2626;"></div>
      <span class="text-sm">F - Médiocre</span>
    </div>
    <div class="legend-item flex items-center gap-2">
      <div class="w-4 h-4 rounded-full" style="background-color: #ef4444;"></div>
      <span class="text-sm">G - Très médiocre</span>
    </div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log('Initialisation de la carte...');
  
  // Initialiser la carte
  const map = L.map('world-map').setView([20, 0], 2);
  
  // Ajouter les tuiles de carte
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
  }).addTo(map);
  
  console.log('Carte initialisée, chargement des pays...');
  
  // Couleurs selon les scores
  function getScoreColor(score) {
    const colors = {
      'A': '#15803d',
      'B': '#16a34a', 
      'C': '#65a30d',
      'D': '#ca8a04',
      'E': '#ea580c',
      'F': '#dc2626',
      'G': '#ef4444'
    };
    return colors[score] || '#9ca3af';
  }
  
  // Coordonnées des pays
  const countryCoordinates = {
    'SE': [60.1282, 18.6435], // Suède
    'DK': [56.2639, 9.5018],  // Danemark
    'MA': [31.7917, -7.0926], // Maroc
    'GB': [55.3781, -3.4360], // Royaume-Uni
    'FR': [46.6034, 1.8883],  // France
    'DE': [51.1657, 10.4515], // Allemagne
    'IT': [41.8719, 12.5674], // Italie
    'BR': [-14.2350, -51.9253], // Brésil
    'CN': [35.8617, 104.1954], // Chine
    'IN': [20.5937, 78.9629], // Inde
    'AU': [-25.2744, 133.7751], // Australie
    'RU': [61.5240, 105.3188], // Russie
    'US': [37.0902, -95.7129], // États-Unis
    'CA': [56.1304, -106.3468] // Canada
  };
  
  // Charger les données des pays
  fetch('/api/countries')
    .then(response => response.json())
    .then(countries => {
      console.log('Pays chargés:', countries.length);
      
      countries.forEach(country => {
        const coords = countryCoordinates[country.code];
        if (coords) {
          const marker = L.circleMarker(coords, {
            radius: 20,
            fillColor: getScoreColor(country.score_letter_rating),
            color: '#fff',
            weight: 3,
            opacity: 1,
            fillOpacity: 0.9
          }).addTo(map);
          
          marker.bindPopup(`
            <div style="text-align: center;">
              <h4 style="margin: 0 0 8px 0; font-weight: bold;">${country.name}</h4>
              <div style="display: inline-block; width: 30px; height: 30px; border-radius: 50%; background-color: ${getScoreColor(country.score_letter_rating)}; color: white; line-height: 30px; font-weight: bold;">
                ${country.score_letter_rating}
              </div>
              <p style="margin: 8px 0 0 0; font-size: 0.9em; color: #666;">
                Score climatique: ${country.score_letter_rating}
              </p>
            </div>
          `);
        }
      });
    })
    .catch(error => {
      console.error('Erreur lors du chargement des pays:', error);
    });
});
</script>
